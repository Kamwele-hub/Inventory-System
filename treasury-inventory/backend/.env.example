# Copy to .env and fill in real values. NEVER commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=inventory.treasury.go.ke,localhost
DATABASE_URL=postgres://treasury_app:CHANGE_ME@db:5432/treasury_inventory
DB_CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/1
CORS_ALLOWED_ORIGINS=https://inventory.treasury.go.ke
SECURE_SSL_REDIRECT=True
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
LOG_LEVEL=INFO

# Background jobs (service-due reminder emails)
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2
SERVICE_REMINDER_INTERVAL_SECONDS=86400

# Email -- defaults to console backend (prints to logs) until you set this
# to django.core.mail.backends.smtp.EmailBackend with real credentials
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=inventory-noreply@treasury.go.ke
SERVICE_REMINDER_ADMIN_EMAILS=
